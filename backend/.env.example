# ============================================================
# RevenueRescue AI — Backend Environment Variables (Template)
# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` file with actual secrets.
# ============================================================

# --- App / Environment ---
APP_ENV=development                # development | staging | production
APP_NAME=RevenueRescue AI
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=revenue_rescue_ai

# --- Redis (Celery broker + result backend + caching) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Razorpay ---
# NOTE: In production, per-business Razorpay keys are stored via the
# secret manager (see Settings API) — these are only fallback/global
# defaults used for local development and testing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Notification Providers ---
# Email (e.g. SendGrid/SES/Postmark — adjust to chosen provider)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=recovery@revenuerescue.ai

# SMS (e.g. Twilio/MSG91)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=xxxxxxxxxxxxxxxxxxxxxxxx
SMS_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
SMS_FROM_NUMBER=+10000000000

# WhatsApp (e.g. WhatsApp Business API / Twilio)
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_FROM_NUMBER=+10000000000

# --- Rate Limiting ---
COPILOT_RATE_LIMIT_PER_HOUR=30
LOGIN_RATE_LIMIT_PER_15_MIN=10
RETRY_ATTEMPTS_MAX_PER_CASE=5

# --- Scheduler / Worker Tuning ---
ABANDONED_CHECKOUT_TIMEOUT_MINUTES=30
RECOVERY_PREDICTION_CACHE_MINUTES=60

# --- Observability ---
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
SENTRY_DSN=
